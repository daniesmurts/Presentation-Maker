---
import Base from '../../layouts/Base.astro'
import { LEGAL_VERSION } from '../../data/operator'
const docs = [
  { href: '/legal/terms',   title: 'Условия использования',       lead: 'Что такое Тезариум, что вы можете делать с результатом, за что отвечаем мы и за что — вы.' },
  { href: '/legal/privacy', title: 'Политика конфиденциальности', lead: 'Какие данные обрабатываются, зачем, где хранятся, кому передаются и как отозвать согласие — в соответствии с 152-ФЗ.' },
]
---
<Base title="Документы — Тезариум" description="Условия использования и политика конфиденциальности Тезариума." canonical="/legal">
  <section style="border-top:0; padding-top: 56px;">
    <div class="wrap">
      <div class="eyebrow pencil">Документы</div>
      <h1 style="margin: 14px 0 10px">Правила и данные</h1>
      <p class="muted" style="margin-bottom: 40px">Редакция от {LEGAL_VERSION}. Принимаются при регистрации; изменения объявляются на этой странице.</p>
      <ul class="docs">
        {docs.map((d) => (
          <li><a href={d.href}><h2>{d.title}</h2><p class="muted">{d.lead}</p></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .docs { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--c-border-strong); max-width: 760px; }
  .docs li { border-bottom: 1px solid var(--c-border); }
  .docs a { display: block; padding: 22px 0; text-decoration: none; color: inherit; }
  .docs h2 { font-size: 1.5rem; margin: 0 0 6px; color: rgb(var(--c-ink)); }
  .docs a:hover h2 { color: rgb(var(--c-accent)); }
</style>
