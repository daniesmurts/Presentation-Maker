---
// The landing. One job: show that Tezarium writes the TALK, not only the
// slides, and get a visitor to «Попробовать бесплатно». Search intent is
// «ИИ для презентаций» / «нейросеть для презентаций» — the landing names
// the category the way people search it (a deliberate exception to the
// app's copy rule, CLAUDE.md §1); the product itself still says what it
// does, not what powers it. No invented numbers, no invented customers.
import Base from '../layouts/Base.astro'
import Replay from '../components/Replay.astro'

// The one price the product has (backend/src/lib/planTier.ts PRO_PRICE_RUB).
// A copy, the site being its own workspace — change it there first.
const PRO_PRICE = 2500

const title = 'Тезариум — ИИ для презентаций, который пишет и текст выступления'
const description = 'Тезариум превращает тезисы в готовое выступление: план на одобрение, слайды, текст докладчика и редактируемый .pptx. Попробуйте бесплатно — без карты.'

const faq = [
  { q: 'Это нейросеть для презентаций?', a: 'Да. Тезариум — ИИ-сервис, который из ваших тезисов пишет план, слайды и текст докладчика. Отличие от других генераторов презентаций — он делает выступление целиком: не только что показать, но и что сказать под каждым слайдом.' },
  { q: 'Что я получу на выходе?', a: 'Редактируемый .pptx (открывается в PowerPoint, Keynote и Google Slides), PDF слайдов — с текстом докладчика или без, ссылку для просмотра без аккаунта и режим показа в браузере с окном докладчика.' },
  { q: 'Можно ли не давать ему ничего додумывать?', a: 'Да — режим «Только по моим материалам»: ничего не добавляется к тезисам. Если материала мало, слайдов будет меньше, а не выдуманных фактов больше.' },
  { q: 'Что такое план на одобрение?', a: 'До того, как написаны слайды, вы видите план: тип, заголовок и суть каждого слайда. Порядок, состав и тип слайдов правятся там за секунды. Поправить структуру до написания дешевле, чем переделывать готовое выступление.' },
  { q: 'Сколько это стоит?', a: `Бесплатно — 2 выступления в месяц, 1 скачивание .pptx и 2 PDF, ссылка для просмотра и режим показа: достаточно, чтобы увидеть весь продукт. Pro — ${PRO_PRICE.toLocaleString('ru-RU')} ₽ в месяц: выступлений и скачиваний без ограничения. Оплата картой через Т-Банк, продление автоматическое, отменить можно в любой момент.` },
  { q: 'Можно загрузить свою презентацию?', a: 'Да: загрузите .pptx — слайды, текст и картинки останутся как есть, и каждый слайд потом можно переписать, дописать к нему текст докладчика или сменить тему.' },
]
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'SoftwareApplication', name: 'Тезариум', alternateName: 'Tezarium', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: 'https://tezarium.ru', description,
      offers: [
        { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'RUB', description: '2 выступления в месяц, 1 .pptx и 2 PDF, ссылка, режим показа' },
        { '@type': 'Offer', name: 'Pro', price: String(PRO_PRICE), priceCurrency: 'RUB', description: 'Выступлений и скачиваний без ограничения', priceSpecification: { '@type': 'UnitPriceSpecification', price: String(PRO_PRICE), priceCurrency: 'RUB', billingDuration: 'P1M' } },
      ], inLanguage: 'ru' },
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
}
---
<Base title={title} description={description} canonical="/">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />

  <!-- Hero: the thesis, then the proof. -->
  <section class="hero" style="border-top:0">
    <div class="wrap">
      <div class="eyebrow pencil">ИИ для презентаций и выступлений</div>
      <h1>От тезисов —<br />к&nbsp;<span class="marker-under">выступлению</span></h1>
      <p class="lede measure">Вы даёте тезисы. Тезариум пишет план, слайды и <strong>текст докладчика</strong> — что говорить, пока слайд на экране. Готовый .pptx редактируется как обычный.</p>
      <div class="ctas">
        <a href="/register" class="btn solid">Попробовать бесплатно</a>
        <span class="muted">2 выступления в месяц бесплатно. Без карты.</span>
      </div>
    </div>
    <div class="wrap demo">
      <div class="demo-cap"><span class="eyebrow">Ниже — настоящий результат</span><span class="muted">пять строк тезисов → план → пять слайдов с текстом докладчика → готовый deck, без правок</span></div>
      <Replay />
    </div>
  </section>

  <!-- How it works: four steps, because the process IS the product. -->
  <section id="how">
    <div class="wrap">
      <div class="eyebrow">Как это работает</div>
      <h2>Четыре шага, и на каждом вы главный</h2>
      <ol class="steps">
        <li><span class="mono n">01</span><h3>Тезисы</h3><p class="muted">Вставьте текст, загрузите файл или дайте ссылку. Выберите цель — убедить, научить, отчитаться, питч — и аудиторию.</p></li>
        <li><span class="mono n">02</span><h3>План — на одобрение</h3><p class="muted">Прежде чем писать слайды, Тезариум показывает план. Переставьте, переименуйте, удалите — пока это стоит секунды.</p></li>
        <li><span class="mono n">03</span><h3>Слайды и текст докладчика</h3><p class="muted">Каждый слайд — со своим текстом на полях и оценкой времени. Любой слайд можно переписать одной фразой: «короче», «добавь пример с цифрами».</p></li>
        <li><span class="mono n">04</span><h3>Выступайте</h3><p class="muted">Скачайте .pptx или PDF, откройте режим показа с окном докладчика на втором экране, поделитесь ссылкой.</p></li>
      </ol>
    </div>
  </section>

  <!-- What is different: three things, each true. -->
  <section class="sheet">
    <div class="wrap">
      <div class="eyebrow">Чем отличается</div>
      <h2>Другие генераторы делают слайды.<br />Тезариум делает выступление.</h2>
      <div class="three">
        <div><h3>Текст докладчика — не заметки</h3><p class="muted">Связный текст под каждый слайд, в вашем темпе и на вашем языке. Можно выключить — питч, который читают с экрана, обходится без него.</p></div>
        <div><h3>Только по вашим материалам</h3><p class="muted">Режим, в котором ничего не додумывается. Меньше материала — меньше слайдов, а не больше выдуманных фактов.</p></div>
        <div><h3>Настоящий .pptx</h3><p class="muted">Не картинки слайдов, а редактируемый файл с вашими цветом и логотипом. Плюс PDF, ссылка для просмотра и показ в браузере.</p></div>
      </div>
    </div>
  </section>

  <!-- Pricing: the offer billing enforces (backend/src/lib/planTier.ts —
       PRO_PRICE_RUB, PLAN_LIMITS). Free loses the native .pptx once
       BILLING_ENABLED is on; until then it is a bonus, never a promise. -->
  <section id="pricing">
    <div class="wrap">
      <div class="eyebrow">Цена</div>
      <h2>Попробуйте бесплатно. Работайте на Pro</h2>
      <div class="plans">
        <div class="plan">
          <div class="eyebrow pencil">Free</div>
          <div class="price">0 ₽</div>
          <ul class="feat">
            <li>2 выступления в месяц — план, слайды, текст докладчика</li>
            <li>1 скачивание .pptx</li>
            <li>2 скачивания PDF</li>
            <li>Ссылка для просмотра, режим показа</li>
            <li>Бренд: цвет, логотип, три темы</li>
          </ul>
          <a href="/register" class="btn solid">Попробовать бесплатно</a>
          <p class="muted small">Без карты.</p>
        </div>
        <div class="plan pro">
          <div class="eyebrow pencil">Pro</div>
          <div class="price">{PRO_PRICE.toLocaleString('ru-RU')} ₽ <span class="per">в месяц</span></div>
          <ul class="feat">
            <li>Выступлений без ограничения</li>
            <li>Скачиваний .pptx и PDF без ограничения</li>
            <li>Редактируемый .pptx открывается в PowerPoint, Keynote и Google Slides</li>
            <li>Ссылка для просмотра, режим показа, бренд</li>
          </ul>
          <a href="/billing" class="btn ghost">Перейти на Pro</a>
          <p class="muted small">Оплата картой через Т-Банк, продление автоматическое, отмена в любой момент — доступ до конца оплаченного месяца.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ: the same text as the FAQPage JSON-LD above. -->
  <section id="faq" class="sheet">
    <div class="wrap">
      <div class="eyebrow">Вопросы</div>
      <h2>Коротко о главном</h2>
      <dl class="faq">
        {faq.map((f) => (<div><dt>{f.q}</dt><dd class="muted">{f.a}</dd></div>))}
      </dl>
    </div>
  </section>

  <section class="last">
    <div class="wrap">
      <h2>Слайды, которые знают, что сказать.</h2>
      <div class="ctas"><a href="/register" class="btn solid">Попробовать бесплатно</a><a href="/login" class="btn ghost">Войти</a></div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 72px 0 80px; }
  .hero h1 { margin: 18px 0 22px; }
  .lede { font-family: var(--display); font-size: clamp(1.15rem, 1.9vw, 1.45rem); line-height: 1.45; color: rgb(var(--c-ink-secondary)); }
  .lede strong { color: rgb(var(--c-ink)); font-weight: 500; }
  .ctas { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 30px; }
  .demo { margin-top: 56px; }
  .demo-cap { display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap; margin-bottom: 12px; font-size: 14px; }

  section h2 { margin: 12px 0 36px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; border-top: 1px solid var(--c-border-strong); }
  .steps li { padding-top: 18px; display: grid; gap: 8px; align-content: start; }
  .steps .n { color: rgb(var(--c-accent)); font-size: 13px; }
  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; border-top: 1px solid var(--c-border-strong); }
  .three > div { padding-top: 18px; display: grid; gap: 8px; align-content: start; }
  .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 820px; }
  .plan { border: 1px solid var(--c-border-strong); border-radius: 10px; padding: 26px 28px 28px; display: grid; gap: 14px; align-content: start; background: rgb(var(--c-surface)); }
  .plan.pro { border-color: rgb(var(--c-ink)); }
  .price .per { font-family: var(--ui); font-size: 15px; font-weight: 400; color: rgb(var(--c-ink-secondary)); }
  .price { font-family: var(--display); font-size: 40px; font-weight: 600; line-height: 1; }
  .feat { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .feat li { position: relative; padding-left: 16px; }
  .feat li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 5px; height: 5px; border-radius: 50%; background: rgb(var(--c-accent)); }
  .small { font-size: 14px; }
  .faq { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--c-border-strong); max-width: 760px; }
  .faq > div { padding: 20px 0; border-bottom: 1px solid var(--c-border); }
  .faq dt { font-family: var(--display); font-weight: 500; font-size: 19px; margin-bottom: 6px; }
  .faq dd { margin: 0; max-width: 62ch; }
  .last h2 { margin-bottom: 24px; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; } .three { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .steps, .plans { grid-template-columns: 1fr; } .hero { padding-top: 48px; } }
</style>
