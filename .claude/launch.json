{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=frontend"
      ],
      "port": 5174
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=backend"
      ],
      "port": 3000
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=landing"
      ],
      "port": 4321
    },
    {
      "name": "site-built",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "preview",
        "--port",
        "4330"
      ],
      "port": 4330,
      "cwd": "landing"
    },
    {
      "name": "site-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "dev",
        "--port",
        "4322"
      ],
      "port": 4322,
      "cwd": "landing"
    }
  ]
}
