# Copy to .env at the repo root. `npm run dev` / `npm start` load it via
# node --env-file; vitest loads it in backend/vitest.setup.ts.

PORT=3000
FRONTEND_URL=http://localhost:5174
DATABASE_URL=postgresql://tezarium:tezarium@localhost:5432/tezarium
# Path to the managed database's CA certificate (TLS with full verification).
# Leave unset for a local database. See deploy/YANDEX-CLOUD.md.
# DATABASE_SSL_CA=/app/certs/root.crt
# Max pg pool connections per Node process. Postgres defaults to 100 total.
DB_POOL_MAX=10
JWT_SECRET=

# LLM. DeepSeek is the launch provider (CLAUDE.md §10: strict JSON mode +
# finish_reason on every call). Additional accounts are DEEPSEEK_API_KEY_2..5
# with optional DEEPSEEK_BASE_URL_N / DEEPSEEK_ACCOUNT_NAME_N — tried in
# order when the primary fails with a retryable error (401/402/403/408/429/5xx).
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEFAULT_LLM_PROVIDER=deepseek

# saas (default) | dedicated | onprem. onprem forbids the silent cross-provider
# fallback in services/llm/registry.ts — see the comment there.
# DEPLOYMENT_MODE=saas

# Object storage for slide images — any S3-compatible endpoint. All four
# unset → files go to ./uploads on local disk (dev only; two replicas on
# one VM broke this assumption once in the parent).
# STORAGE_ENDPOINT=https://storage.yandexcloud.net
# STORAGE_REGION=ru-central1
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Platform-wide daily model-spend backstop in USD (services/globalSpendCap.ts).
# Unset → no global cap. Per-workspace monthly caps are per plan tier
# (lib/planTier.ts) with an optional override column on workspaces.
# GLOBAL_DAILY_SPEND_CAP_USD=

# Billing — the Pro subscription through Т-Банк internet acquiring
# (services/billing.ts). Unset → no billing: the .pptx gate stays open to
# every tier and /api/billing answers PLAN_BILLING_OFF. Keys come from the
# merchant cabinet (a test pair exists there); TBANK_API_URL only for the
# test host. PUBLIC_API_URL is where T-Bank posts notifications
# (…/api/billing/tbank/notify) — defaults to FRONTEND_URL, which is right
# behind Caddy. Taxation / VAT are the receipt's 54-ФЗ facts.
# T-Bank's API is signed by the Russian Trusted (Минцифры) CA — not in any
# default trust store. The image sets this; locally, export it before
# `npm run dev` (see backend/assets/certs/README.md).
# NODE_EXTRA_CA_CERTS=backend/assets/certs/russian_trusted_ca_bundle.pem
# BILLING_ENABLED=1
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# TBANK_API_URL=https://securepay.tinkoff.ru/v2
# PUBLIC_API_URL=https://tezarium.ru
# TBANK_TAXATION=usn_income
# TBANK_VAT=none

# LOG_LEVEL=info
